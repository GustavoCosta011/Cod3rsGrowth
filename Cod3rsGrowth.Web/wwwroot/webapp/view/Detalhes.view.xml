<mvc:View
    controllerName="cod3rsgrowth.webapp.controller.Detalhes"
    xmlns:m="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:layout="sap.ui.layout">
    
    <m:Page title="{i18n>Page.Detalhes.Titulo}" 
        id="PaginaDeDetalhes"
        showNavButton="true"
        navButtonPress="aoClicarEmVoltar"
        class="sapUiResponsiveContentPadding">
        
        <ObjectPageLayout id="ObjectPageLayout" height="auto"
            enableLazyLoading="true"
            useIconTabBar="true"
            showTitleInHeaderContent="true"
            headerContentPinnable="false"
            
            upperCaseAnchorBar="true">
            
            <headerTitle>
                <ObjectPageDynamicHeaderTitle>
                    <expandedHeading>
                        <m:Title text="{clube>/nome}" wrapping="true"/>
                    </expandedHeading>

                    <snappedHeading>
                        <m:FlexBox fitContainer="true" alignItems="Center">
                            <m:Avatar class="sapUiSmallMarginEnd" src="./webapp/Imagens/EscudoClube.jpg" displaySize="L" />
                            <m:Title title="{i18n>Page.Detalhes.Nome.Titulo}" text="{clube>/nome}" wrapping="true"/>
                        </m:FlexBox>
                    </snappedHeading>

                    <expandedContent>
                        <m:Text text="Clube de futebol"/>
                    </expandedContent>

                    <snappedContent>
                        <m:Text text="Clube de futebol"/>
                    </snappedContent>

                    <snappedTitleOnMobile>
                        <m:Title text="Clube de futebol"/>
                    </snappedTitleOnMobile>

                    <actions>
                        <m:Button
                            width="6rem"
                            id="BotaoEditar"
                            text="{i18n>Page.Detalhes.Botao.Editar}"
                            press="aoClicarEditar"
                            type="{i18n>Botao.Limpar.Filtros.Tipo}"/>
                        <m:Button
                            width="6rem"
                            id="BotaoDeletar"
                            text="{i18n>Page.Detalhes.Botao.Deletar}"
                            press="aoClicarDeletar"
                            type="Default"/>
                    </actions>
                </ObjectPageDynamicHeaderTitle>
            </headerTitle>

            <headerContent>
                <m:FlexBox wrap="Wrap" fitContainer="true" >
                    <m:Avatar class="sapUiSmallMarginEnd" src="./webapp/Imagens/EscudoClube.jpg" displaySize="L" />
                    <layout:VerticalLayout>
                        <m:ObjectStatus title="{i18n>Page.Detalhes.Fundacao.Titulo}" text="{path: 'clube>/fundacao', formatter: '.formatter.formatDate'}"/>   
                        <m:ObjectStatus title="{i18n>Page.Detalhes.Estadio.Titulo}" text="{clube>/estadio}"/>
                        <m:ObjectStatus title="{i18n>Page.Detalhes.Estado.Titulo}" text="{clube>/estado}"/>
                        <m:ObjectStatus
                            title="{i18n>Page.Detalhes.Cobertura.Titulo}"
                            class="sapUiSmallMarginBottom"
                            icon="{path : 'clube>/coberturaAntiChuva', formatter: '.formatter.formatIcon'}"
                            state="{path : 'clube>/coberturaAntiChuva', formatter: '.formatter.formatBolean'}"/>
                    </layout:VerticalLayout>
                </m:FlexBox>
            </headerContent>

            <sections>
                <ObjectPageSection titleUppercase="false" id="SessaoElenco" title="Elenco">
                    <subSections>
                        <ObjectPageSubSection id="JogadoresDoElenco" title="Jogadores" titleUppercase="false">
                            <blocks>
                                <m:VBox justifyContent="Start" alignItems="Start" width="100%">
                                    <m:VBox justifyContent="Start" alignItems="Start" width="100%">
                                        <m:Button
                                            width="6rem"
                                            id="BotaoCriarJogador"
                                            text="{i18n>Page.Detalhes.Botao.Criar.Jogador}"
                                            press="aoAbrirModalDeCriacao"
                                            type="Emphasized"/>
                                    </m:VBox>
                                    <m:Table
                                        items="{jogadores>/}"
                                        id="Elenco"
                                        backgroundDesign="{i18n>Page.Detalhes.Tabela.Design}"
                                        alternateRowColors="true"
                                        growing="true"
                                        growingThreshold="10"
                                        growingTriggerText="{i18n>Page.Detalhes.Tabela.Growing}"
                                        mode = "Delete"
                                        delete="aoDeletarJogador"
                                        >
                                        <m:columns>
                                            <m:Column width="12em">
                                                <m:Text text="{i18n>Page.Detalhes.Tabela.Coluna.Nome}"/>
                                            </m:Column>
                                            <m:Column width="12em">
                                                <m:Text text="{i18n>Page.Detalhes.Tabela.Coluna.Idade}"/>
                                            </m:Column>
                                            <m:Column width="12em">
                                                <m:Text text="{i18n>Page.Detalhes.Tabela.Coluna.DataDeNascimento}"/>
                                            </m:Column>
                                        </m:columns>
                                        <m:items>
                                            <m:ColumnListItem vAlign="Middle" type="Detail" detailPress="aoAbrirModalDeCriacao">  
                                                <m:cells>
                                                    <m:ObjectIdentifier text="{jogadores>nome}"/>
                                                    <m:Text text="{jogadores>idade}"/>
                                                    <m:Text text="{path: 'jogadores>dataDeNascimento', formatter: '.formatter.formatDate'}"/>
                                                </m:cells>
                                            </m:ColumnListItem>
                                        </m:items>
                                    </m:Table>
                                </m:VBox>
                            </blocks>
                        </ObjectPageSubSection>
                    </subSections>
                </ObjectPageSection>
                <ObjectPageSection titleUppercase="false" id="SessaoHistoria" title="História">
                    <subSections>
                        <ObjectPageSubSection id="DetalhesHistoria" title="Detalhes" titleUppercase="false">
                            <blocks>
                                <m:Text text="Aqui vai o conteúdo sobre a história do clube." />
                            </blocks>
                        </ObjectPageSubSection>
                    </subSections>
                </ObjectPageSection>
            </sections>
        </ObjectPageLayout>
    </m:Page>
</mvc:View>
