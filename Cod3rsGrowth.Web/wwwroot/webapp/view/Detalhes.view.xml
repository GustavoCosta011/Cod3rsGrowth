<mvc:View
	controllerName="cod3rsgrowth.webapp.controller.Detalhes"
	xmlns:m="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:layout="sap.ui.layout">
	<m:Page title="{i18n>Page.Detalhes.Titulo}" 
        id="PaginaDeDetalhes"
        showNavButton="true"
        navButtonPress="aoClicarEmVoltar"
        class="sapUiResponsiveContentPadding"
        >
	    <ObjectPageLayout id="ObjectPageLayout" height="100%">
            <headerContent>        
            <m:Avatar class="sapUiSmallMarginEnd" src="./webapp/Imagens/EscudoClube.jpg" displaySize="L" />
                <layout:VerticalLayout>
                    <m:Title title= "{i18n>Page.Detalhes.Nome.Titulo}" text="{clubes>/nome}"/>
                    <m:ObjectStatus title="{i18n>Page.Detalhes.Fundacao.Titulo}" text= "{path: 'clubes>/fundacao', formatter: '.formatter.formatDate'}"/>   
                    <m:ObjectStatus title="{i18n>Page.Detalhes.Estadio.Titulo}" text="{clubes>/estadio}"/>
                    <m:ObjectStatus title="{i18n>Page.Detalhes.Estado.Titulo}" text="{clubes>/estado}"/>
                </layout:VerticalLayout>
                <layout:VerticalLayout>
                    <m:ObjectStatus
                        title="{i18n>Page.Detalhes.Cobertura.Titulo}"
                        class="sapUiSmallMarginBottom"
                        icon="{path : 'clubes>/coberturaAntiChuva', formatter: '.formatter.formatIcon'}"
                        state="{path : 'clubes>/coberturaAntiChuva', formatter: '.formatter.formatBolean'}"/>
                </layout:VerticalLayout>
                <m:ToolbarSpacer width= "50%"/>
                <layout:VerticalLayout>
                    <m:Button
                        width="6rem"
                        id="BotaoEditar"
                        text="{i18n>Page.Detalhes.Botao.Editar}"
                        press="aoClicarEditar"
                        type="{i18n>Botao.Limpar.Filtros.Tipo}"/>
                     <m:Button
                        width="6rem"
                        id="BotaoDeletar"
                        text="{i18n>Page.Detalhes.Botao.Deletar}"
                        press="aoClicarDeletar"
                        type="Default"/>   
                 </layout:VerticalLayout>   
            </headerContent>
	    </ObjectPageLayout>
	</m:Page>
</mvc:View>