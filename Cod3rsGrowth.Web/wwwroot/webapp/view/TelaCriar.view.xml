<mvc:View
    controllerName="cod3rsgrowth.webapp.controller.TelaCriar"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core">
    <Page title="Criar Clube" class="sapUiResponsiveContentPadding" showNavButton="true" navButtonPress="_onNavBack('clubes')">
        <VBox justifyContent="Center" alignItems="Center" class="sapUiSmallMargin">
            <VBox width="50%" class="customVBox">
                <VBox justifyContent="Center" alignItems="Center">
                    <Title  text= "Clube"/>
                </VBox>
                <Label text="Nome:" />
                <Input
                    id="InputNome"
                    width="100%"
                    placeholder="Insira o Nome"
                    change="aoInserirNome"
                    liveChange="true"
                />
                <Label text="Fundação:"/>
                <DatePicker
                    id="CalendarioCriar"
                    width="100%"
                    placeholder="Insira a Fundação"
                    change="aoInserirFundação"
                    liveChange="true"
                    displayFormat="dd/MM/yyyy"
                    class="sapUiSmallMarginBottom"
                    visible="true"
                />
                <Label text="Estadio:"/>
                <Input
                    id="InputEstadio"
                    width="100%"
                    valueState="None" 
                    valueStateText= "O campo 'Estadio' é obrigatório."
                    placeholder="Insira o Nome do Estadio"
                    change="aoInserirEstadio"
                    liveChange="true"
                />
                <Label text="Estado:"/>
                <ComboBox id="EstadoCriacao"
                    width="100%"
                    placeholder="Insira o Estado do Clube"
                    selectionChange="aoInserirEstadoDeCriação">
                    <items>
                        <core:Item text="Acre" key="0"/>
                        <core:Item text="Alagoas" key="1"/>
                        <core:Item text="Amapá" key="2"/>
                        <core:Item text="Amazonas" key="3"/>
                        <core:Item text="Bahia" key="4"/>
                        <core:Item text="Ceará" key="5"/>
                        <core:Item text="Espírito Santo" key="6"/>
                        <core:Item text="Goiás" key="7"/>
                        <core:Item text="Maranhão" key="8"/>
                        <core:Item text="Mato Grosso" key="9"/>
                        <core:Item text="Mato Grosso do Sul" key="10"/>
                        <core:Item text="Minas Gerais" key="11"/>
                        <core:Item text="Pará" key="12"/>
                        <core:Item text="Paraíba" key="13"/>
                        <core:Item text="Paraná" key="14"/>
                        <core:Item text="Pernambuco" key="15"/>
                        <core:Item text="Piauí" key="16"/>
                        <core:Item text="Rio de Janeiro" key="17"/>
                        <core:Item text="Rio Grande do Norte" key="18"/>
                        <core:Item text="Rio Grande do Sul" key="19"/>
                        <core:Item text="Rondônia" key="20"/>
                        <core:Item text="Roraima" key="21"/>
                        <core:Item text="Santa Catarina" key="22"/>
                        <core:Item text="São Paulo" key="23"/>
                        <core:Item text="Sergipe" key="24"/>
                        <core:Item text="Tocantins" key="25"/>
                        <core:Item text="Distrito Federal" key="26"/>
                    </items>
                </ComboBox>
                <Label text="O estadio do clube possui Cobertura Anti-Chuva?"/>
                <RadioButtonGroup id="CoberturaAntiChuva" select="aoInserirCobertura">
					<RadioButton id="BotaoSim" text="Sim" selected="false"/>
					<RadioButton id="BotaoNao" text="Não" selected="false"/>
				</RadioButtonGroup>
                <Button text="Salvar" press="aoSalvarClube" class="sapUiSmallMarginTop"/>
            </VBox>
        </VBox>
    </Page>
</mvc:View>
