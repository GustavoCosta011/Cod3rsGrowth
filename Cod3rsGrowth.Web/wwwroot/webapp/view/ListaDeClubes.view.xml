<mvc:View
    controllerName="cod3rsgrowth.controller.ListaDeClubes"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt">
    <Page 
        id="PaginaDaListaClubes"
        title="{i18n>ListPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding">
        <VBox>
            <OverflowToolbar>
                <content>
                    <Toolbar>
                        <Title text="Nome :" />
                        <ToolbarSpacer width="2em"/>
                        <Input
                            id="InputNome"
                            width="60%"
                            change="aoBuscarPorNome"
                            liveChange="true"/>
                    </Toolbar>
                    <ToolbarSeparator/>
                    <Toolbar>
                        <Title text="Estado :"/>
                        <ToolbarSpacer/>
                        <ComboBox id="ComboBoxEstados"
                            width="60%"
                            placeholder="Selecione o estado"
                            selectionChange="aoMudarOEstadoNaComboBox">
                            <items>
                                <core:Item text="Nenhum" key="-1"/>
                                <core:Item text="Acre" key="0"/>
                                <core:Item text="Alagoas" key="1"/>
                                <core:Item text="Amapá" key="2"/>
                                <core:Item text="Amazonas" key="3"/>
                                <core:Item text="Bahia" key="4"/>
                                <core:Item text="Ceará" key="5"/>
                                <core:Item text="Espírito Santo" key="6"/>
                                <core:Item text="Goiás" key="7"/>
                                <core:Item text="Maranhão" key="8"/>
                                <core:Item text="Mato Grosso" key="9"/>
                                <core:Item text="Mato Grosso do Sul" key="10"/>
                                <core:Item text="Minas Gerais" key="11"/>
                                <core:Item text="Pará" key="12"/>
                                <core:Item text="Paraíba" key="13"/>
                                <core:Item text="Paraná" key="14"/>
                                <core:Item text="Pernambuco" key="15"/>
                                <core:Item text="Piauí" key="16"/>
                                <core:Item text="Rio de Janeiro" key="17"/>
                                <core:Item text="Rio Grande do Norte" key="18"/>
                                <core:Item text="Rio Grande do Sul" key="19"/>
                                <core:Item text="Rondônia" key="20"/>
                                <core:Item text="Roraima" key="21"/>
                                <core:Item text="Santa Catarina" key="22"/>
                                <core:Item text="São Paulo" key="23"/>
                                <core:Item text="Sergipe" key="24"/>
                                <core:Item text="Tocantins" key="25"/>
                                <core:Item text="Distrito Federal" key="26"/>
                            </items>
                        </ComboBox>
                    </Toolbar>
                    <ToolbarSeparator/>
                    <Toolbar>
                        <Title text="Fundação :"/>
                        <ToolbarSpacer/>
                        <DateRangeSelection
                            id="calendario"
                            width="60%"
                            placeholder="Defina o range"
                            change="aoAlterarData"
                            liveChange="true"
                            showFooter="true"/>
                    </Toolbar>
                    <ToolbarSpacer/>
                    <Toolbar>
                        <Button
                            text="Limpar"
                            press="aoLimparOsFiltros"
                            type="Emphasized"/>
                    </Toolbar>
                </content>
            </OverflowToolbar>
            <VBox height="1em"/>
            <Table id="ListaDeClubes"
                items="{ path: '/' }"
                backgroundDesign="Solid"
                alternateRowColors="true"
                growing="true"
                growingThreshold="10"
                growingTriggerText="Mais">
                <columns>
                    <Column width="12em">
                        <Text text="Clube"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="Fundação"/>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
                        <Text text="Estádio"/>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
                        <Text text="Estado"/>
                    </Column>
                    <Column hAlign="Center">
                        <Text text="Cobertura Anti-Chuva"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <ObjectIdentifier text="{nome}"/>
                            <Text text="{path: 'fundacao', formatter: '.formatter.formatDate'}"/>
                            <Text text="{estadio}"/>
                            <Text text="{estado}"/>
                            <Text text="{coberturaAntiChuva}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
