<mvc:View
    controllerName="cod3rsgrowth.controller.ListaDeClubes"
    xmlns:m="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"  
    height="100%"
    xmlns="sap.ui.table"
>
    <m:Page 
        id="PaginaDaListaClubes"
        title="{i18n>homePageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding"
    >
        <m:content>
            <Table 
                id="ListaDeCllubes"  
                alternateRowColors="true" 
                rows="{ path: '/' }"
            >
                <extension>
                    <m:OverflowToolbar>
                        <m:Title text="Clubes" level="H2"/>
                        <m:ToolbarSpacer />
                        <m:Button
                            icon="sap-icon://decline"
                            tooltip="Limpar Filtros"
                            press="LimparTodosFiltros"
                        />
                        <m:ComboBox 
                            id="ComboBoxEstados"
                            placeholder="Selecione o estado"
                            change="aoMudarOEstadoNaComboBox"
                        >
                            <m:items>
                                <core:Item text="AC" key="0"/>
                                <core:Item text="AL" key="1"/>
                                <core:Item text="AP" key="2"/>
                                <core:Item text="AM" key="3"/>
                                <core:Item text="BA" key="4"/>
                                <core:Item text="CE" key="5"/>
                                <core:Item text="DF" key="6"/>
                                <core:Item text="ES" key="7"/>
                                <core:Item text="GO" key="8"/>
                                <core:Item text="MA" key="9"/>
                                <core:Item text="MT" key="10"/>
                                <core:Item text="MS" key="11"/>
                                <core:Item text="MG" key="12"/>
                                <core:Item text="PA" key="13"/>
                                <core:Item text="PB" key="14"/>
                                <core:Item text="PR" key="15"/>
                                <core:Item text="PE" key="16"/>
                                <core:Item text="PI" key="17"/>
                                <core:Item text="RJ" key="18"/>
                                <core:Item text="RN" key="19"/>
                                <core:Item text="RS" key="20"/>
                                <core:Item text="RO" key="21"/>
                                <core:Item text="RR" key="22"/>
                                <core:Item text="SC" key="23"/>
                                <core:Item text="SP" key="24"/>
                                <core:Item text="SE" key="25"/>
                                <core:Item text="TO" key="26"/>
                            </m:items>
                        </m:ComboBox>
                        <m:ToolbarSeparator/>
                        <m:Toolbar>
                            <m:Title text="Nome" />
                            <m:ToolbarSpacer />
                            <m:SearchField
                                width="70%"
                                liveChange="aoFiltrarClubesComNome"
                            />
                        </m:Toolbar>
                    </m:OverflowToolbar>
                </extension>
                <columns>
                    <Column
                        width="1rem"
                        filterProperty="Id"
                    >
                        <m:Label text="id" />
                        <template>
                            <m:Text text="{id}" wrapping="false" />
                        </template>
                    </Column>
                    <Column
                        width="11rem"
                        filterProperty="Name"
                    >
                        <m:Label text="Nome do Clube" />
                        <template>
                            <m:Text text="{nome}" wrapping="false" />
                        </template>
                    </Column>
                    <Column
                        width="11rem"
                        filterProperty="Fundação"
                    >
                        <m:Label text="Fundação" />
                        <template>
                            <m:Text text="{fundacao}" wrapping="false" />
                        </template>
                    </Column>
                    <Column
                        width="9rem"
                        filterProperty="Estadio"
                    >
                        <m:Label text="Estadio" />
                        <template>
                            <m:Text text="{estadio}" wrapping="false"/>
                        </template>
                    </Column>
                    <Column
                        hAlign="Center"
                        width="6rem"
                        filterProperty="Estado"
                    >
                        <m:Label text="Estado" />
                        <template>
                            <m:Text text="{ path: 'estado', formatter: '.formatter.formatEstado' }" wrapping="false" />
                        </template>
                    </Column>
                    <Column
                        hAlign="Center"
                        width="9rem"
                    >
                        <m:Label text="Cobertura Anti-Chuva" />
                        <template>
                            <m:Text text="{coberturaAntiChuva}" />
                        </template>
                    </Column>
                </columns>
            </Table>
        </m:content>
    </m:Page>
</mvc:View>
