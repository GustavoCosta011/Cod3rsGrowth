<mvc:View
    controllerName="cod3rsgrowth.controller.ListaDeClubes"
    xmlns:m="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"  
    height="100%"
    xmlns="sap.ui.table"
>
    <m:Page 
        id="PaginaDaListaClubes"
        title="{i18n>homePageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding"
    >
        <m:content>
            <Table 
                id="ListaDeCllubes"  
                alternateRowColors="true" 
                rows="{ path: '/' }"
                columnResize="false"
                enableColumnReordering="false"
            >
                <extension>
                    <m:OverflowToolbar>
                        <m:Title text="Clubes" level="H2"/>
                        <m:ToolbarSpacer />
                        <m:Button
                            icon="sap-icon://decline"
                            tooltip="Limpar Filtros"
                            press="LimparTodosFiltros"
                        />
                        <m:ComboBox 
                            id="ComboBoxEstados"
                            placeholder="Selecione o estado"
                            change="aoMudarOEstadoNaComboBox"
                        >
                            <m:items>
                                <core:Item text="Acre" key="0"/>
                                <core:Item text="Alagoas" key="1"/>
                                <core:Item text="Amapá" key="2"/>
                                <core:Item text="Amazonas" key="3"/>
                                <core:Item text="Bahia" key="4"/>
                                <core:Item text="Ceará" key="5"/>
                                <core:Item text="Distrito Federal" key="6"/>
                                <core:Item text="Espírito Santo" key="7"/>
                                <core:Item text="Goiás" key="8"/>
                                <core:Item text="Maranhão" key="9"/>
                                <core:Item text="Mato Grosso" key="10"/>
                                <core:Item text="Mato Grosso do Sul" key="11"/>
                                <core:Item text="Minas Gerais" key="12"/>
                                <core:Item text="Pará" key="13"/>
                                <core:Item text="Paraíba" key="14"/>
                                <core:Item text="Paraná" key="15"/>
                                <core:Item text="Pernambuco" key="16"/>
                                <core:Item text="Piauí" key="17"/>
                                <core:Item text="Rio de Janeiro" key="18"/>
                                <core:Item text="Rio Grande do Norte" key="19"/>
                                <core:Item text="Rio Grande do Sul" key="20"/>
                                <core:Item text="Rondônia" key="21"/>
                                <core:Item text="Roraima" key="22"/>
                                <core:Item text="Santa Catarina" key="23"/>
                                <core:Item text="São Paulo" key="24"/>
                                <core:Item text="Sergipe" key="25"/>
                                <core:Item text="Tocantins" key="26"/>
                            </m:items>
                        </m:ComboBox>
                        <m:ToolbarSeparator/>
                        <m:Toolbar>
                            <m:Title text="Nome" />
                            <m:ToolbarSpacer />
                            <m:SearchField
                                width="70%"
                                liveChange="aoFiltrarClubesComNome"
                            />
                        </m:Toolbar>
                    </m:OverflowToolbar>
                </extension>
                <columns>
                    <Column
                        autoResizable="false" 
                        resizable="false"
                        width="5%"
                        filterProperty="Id" 
                    >
                        <m:Label text="id" />
                        <template>
                            <m:Text text="{id}" wrapping="false" />
                        </template>
                    </Column>
                    <Column
                        autoResizable="false" 
                        resizable="false"
                        width="15%"
                        filterProperty="Name"
                    >
                        <m:Label text="Nome do Clube" />
                        <template>
                            <m:Text text="{nome}" wrapping="false" />
                        </template>
                    </Column>
                    <Column
                        autoResizable="false" 
                        resizable="false"
                        width="15%"
                        filterProperty="Fundação"
                    >
                        <m:Label text="Fundação" />
                        <template>
                            <m:Text text="{fundacao}" wrapping="false" />
                        </template>
                    </Column>
                    <Column
                        autoResizable="false" 
                        resizable="false"
                        width="15%"
                        filterProperty="Estadio"
                    >
                        <m:Label text="Estadio" />
                        <template>
                            <m:Text text="{estadio}" wrapping="false"/>
                        </template>
                    </Column>
                    <Column
                        autoResizable="false" 
                        resizable="false"
                        hAlign="Center"
                        width="20%"
                        filterProperty="Estado"
                    >
                        <m:Label text="Estado" />
                        <template>
                            <m:Text text = "{estado}" wrapping="false" />
                        </template>
                    </Column>
                    <Column
                        autoResizable="false" 
                        resizable="false"
                        hAlign="Center"
                        width="20%"
                    >
                        <m:Label text="Cobertura Anti-Chuva" />
                        <template>
                            <m:Text text="{coberturaAntiChuva}" />
                        </template>
                    </Column>
                </columns>
            </Table>
            <m:Toolbar>
                <m:Button text="Anterior" press="onPreviousPage" />
                <m:Button text="Próximo" press="onNextPage" />
            </m:Toolbar>
        </m:content>
    </m:Page>
</mvc:View>
