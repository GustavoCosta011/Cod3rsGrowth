<mvc:View
	controllerName="cod3rsgrowth.controller.ListaDeClubes"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
<Page 
    id="PaginaDaListaClubes"
    title="{i18n>homePageTitle}"
    showNavButton="true"
    navButtonPress=".onNavBack"
    class="sapUiResponsiveContentPadding">
    <Table  id="ListaDeCllubes" items = "{ path: '/' }" alternateRowColors= "true">
        <headerToolbar>
            <OverflowToolbar>
                <content>
                    <Title text="Clubes" level="H6"/>
                    <ToolbarSpacer />
                    <ComboBox id="ComboBoxEstados"
                        placeholder="Selecione o estado"
                        change="aoMudarOEstadoNaComboBox">
                        <items>
                            <core:Item text="AC" key="0"/>
                            <core:Item text="AL" key="1"/>
                            <core:Item text="AP" key="2"/>
                            <core:Item text="AM" key="3"/>
                            <core:Item text="BA" key="4"/>
                            <core:Item text="CE" key="5"/>
                            <core:Item text="DF" key="6"/>
                            <core:Item text="ES" key="7"/>
                            <core:Item text="GO" key="8"/>
                            <core:Item text="MA" key="9"/>
                            <core:Item text="MT" key="10"/>
                            <core:Item text="MS" key="11"/>
                            <core:Item text="MG" key="12"/>
                            <core:Item text="PA" key="13"/>
                            <core:Item text="PB" key="14"/>
                            <core:Item text="PR" key="15"/>
                            <core:Item text="PE" key="16"/>
                            <core:Item text="PI" key="17"/>
                            <core:Item text="RJ" key="18"/>
                            <core:Item text="RN" key="19"/>
                            <core:Item text="RS" key="20"/>
                            <core:Item text="RO" key="21"/>
                            <core:Item text="RR" key="22"/>
                            <core:Item text="SC" key="23"/>
                            <core:Item text="SP" key="24"/>
                            <core:Item text="SE" key="25"/>
                            <core:Item text="TO" key="26"/>
                        </items>
                    </ComboBox>
                    <Toolbar>
                        <Title text="Nome" />
                        <ToolbarSpacer />
                        <SearchField
                            width="70%"
                            liveChange="aoFiltrarClubesComNome"
                        />
                    </Toolbar>
                </content>
            </OverflowToolbar>
        </headerToolbar>
        <columns> 
			<Column
				width="12em">
				<Text text="Clube" />
			</Column>
			<Column
				minScreenWidth="Tablet"
				demandPopin="true">
				<Text text="Fundacao" />
			</Column>
			<Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="End">
				<Text text="Estadio" />
			</Column>
			<Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Center">
				<Text text="Estado" />
			</Column>
			<Column
				hAlign="End">
				<Text text="Cobertura Anti-Chuva"/>
			</Column>
            <Column
				hAlign="End">
				<Text text="Cobertura Anti-Chuva"/>
			</Column>
		</columns>
        <items  >
			<ColumnListItem vAlign="Middle" selected="true" press=".aoPressionarUmItem">
				<cells>
					<ObjectIdentifier
						title="{nome}"
						text="{id}"/>
					<Text
						text="{fundacao}"/>
					<Text
						text="{estadio}"/>
					<Text
                        text="{estado}"/>
					<Text
                        text="{coberturaAntiChuva}"/>
				</cells>
			</ColumnListItem>
		</items>
    </Table>
</Page>
</mvc:View>
