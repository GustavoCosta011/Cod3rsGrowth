{
    "_version": "1.58.0",
    "sap.app": {
        "id": "ui5.cod3rsgrowth",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "{{appTitle}}"
    },	
    "sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
	    }
    },
    "sap.ui5": {
        "rootView": {
            "id": "app",
            "type": "XML",
            "viewName": "cod3rsgrowth.view.App"
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "cod3rsgrowth.i18n.i18n"
                }
            }
        },
        "clubes" : {
				"type": "sap.ui.model.json.JSONModel",
				"uri" : "https://localhost:7178//api/Clubes"
		},
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "dependencies": {
            "minUI5Version": "1.108.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "routing": {
            "config":{
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "cod3rsgrowth.view",
                "controlId": "app",
                "controlAggregation": "pages",
                "transition": "slide",
                "bypassed": {
                    "target": "notFound"
                },
                "async": true
            },
            "routes": [{
                "pattern": "",
                "name": "Home",
                "target": "home"
            },
            {
                "pattern": "clubes:?query:",
                "name": "clubes",
                "target": "clubes"
            }],
            "targets": {
                "home": {
                    "id": "home",
                    "name": "Home",
                    "level" : 1
                },
                "notFound": {
                    "id": "NotFound",
                    "name": "NotFound",
                    "transition": "show"
                },
                "clubes": {
                    "id": "clubes",
                    "name": "ListaDeClubes",
                    "level": 2
                }
            }
        }         
    }
}